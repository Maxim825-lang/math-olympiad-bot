# ── Токен Telegram-бота ──────────────────────────────────────────────────────
# Получить у @BotFather в Telegram
BOT_TOKEN=your_bot_token_here

# ── Ваш Telegram ID ──────────────────────────────────────────────────────────
# Узнать у @userinfobot в Telegram
ADMIN_ID=your_telegram_id_here

# ── URL вашего сервиса на Render ─────────────────────────────────────────────
# Формат: https://ИМЯ-СЕРВИСА.onrender.com  (без слэша в конце!)
# Нужен только при деплое на Render, для локальной работы не нужен
WEBHOOK_URL=https://your-service-name.onrender.com

# ── База данных ───────────────────────────────────────────────────────────────
# Для локальной работы оставьте как есть
# На Render тоже оставьте — SQLite файл создастся автоматически
DATABASE_URL=sqlite+aiosqlite:///problems.db
